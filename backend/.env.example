PROJECT_TITLE=Vehicle License Plate Recognition for Unauthorized Entry Alert
SERVICE_NAME=vehicle-license-backend
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:3000
MAX_IMAGE_BYTES=10485760
MIN_IMAGE_WIDTH=32
MIN_IMAGE_HEIGHT=32
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000
MAX_IMAGE_PIXELS=25000000
DETECTOR_MODEL_PATH=models/day4/best.onnx
DETECTOR_CONFIDENCE_THRESHOLD=0.25
DETECTOR_NMS_IOU_THRESHOLD=0.45
OCR_MIN_CONFIDENCE=0.80
OCR_FULL_PIPELINE_FALLBACK=true

